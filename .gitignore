# data lake / large files
# NOTE the leading slashes. A bare "data/" matches a directory of that name at
# ANY depth, which silently excluded the src/tsl/data package from git - the
# working tree looked fine and a fresh clone was broken.
/data/
*.parquet
*.csv
*.h5

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# secrets — API keys, broker credentials
.env
.env.*
config/secrets.yaml
credentials.json

# outputs
/reports/
/logs/
*.log
